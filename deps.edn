{:paths ["src"]
 :deps  {org.clojure/clojure                      {:mvn/version "1.11.1"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {lambdaisland/kaocha {:mvn/version "1.75.1190"}
                       org.xerial/sqlite-jdbc {:mvn/version "3.46.1.3"}
                       org.postgresql/postgresql {:mvn/version "42.6.0"}
                       hikari-cp/hikari-cp {:mvn/version "3.0.1"}
                       org.clojure/data.json {:mvn/version "2.4.0"}}
         :main-opts   ["-m" "kaocha.runner"]}
  ;; SQLite-only subset with no JVM-only deps (hikari-cp, postgres driver). Used
  ;; to run the suite on the same surface jolt exercises; the postgres and
  ;; connection-pool tests live in jdbc.postgres-test and are excluded here.
  :jolt {:extra-paths ["test"]
         :extra-deps  {lambdaisland/kaocha {:mvn/version "1.75.1190"}
                       org.xerial/sqlite-jdbc {:mvn/version "3.46.1.3"}}
         :main-opts   ["-m" "kaocha.runner" "--config-file" "tests-jolt.edn"]}}}
